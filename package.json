{
  "name": "rhythm-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --run dev:server & vite",
    "dev:server": "RG_DEV=1 PORT=5174 tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && tsx server/index.ts",
    "test": "vitest run",
    "setup-ai": "bash scripts/setup-ai.sh"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
